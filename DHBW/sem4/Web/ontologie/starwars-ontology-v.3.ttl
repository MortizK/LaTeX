@prefix : <urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd> .

<urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd> rdf:type owl:Ontology ;
                                                                rdfs:comment "Formale Ontologie des Star-Wars-Universums zur semantischen Modellierung von Charakteren, Organisationen, Ereignissen, Fahrzeugen, Himmelskörpern und zentralen Handlungsereignissen aus den Episoden I–VI unter Verwendung von OWL 2. Die Ontologie ermöglicht logische Inferenz, Konsistenzprüfung und automatisches Ableiten von Beziehungen mithilfe von Reasonern wie HermiT."@de .

#################################################################
#    Object Properties
#################################################################

###  http://webprotege.stanford.edu/R8BaQuU8CrsgAlHU7bH0vUd
<http://webprotege.stanford.edu/R8BaQuU8CrsgAlHU7bH0vUd> rdf:type owl:ObjectProperty ;
                                                         owl:inverseOf :hatMitglied ;
                                                         rdf:type owl:TransitiveProperty ;
                                                         rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
                                                         rdfs:range <http://webprotege.stanford.edu/R9zzbJR0kGITkMs3EriLmSs> ;
                                                         rdfs:comment "Ordnet einen Charakter einer Organisation zu."@de ;
                                                         rdfs:label "mitgliedVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#befindetSichAuf
:befindetSichAuf rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ,
                             <http://webprotege.stanford.edu/RkOjPOSAupTHuJkOYZlvuK> ;
                 rdfs:range <http://webprotege.stanford.edu/R7Tk9abCoMQfGECrnxgjOXl> ;
                 rdfs:comment "Ordnet Charaktere oder Objekte einem Himmelskörper zu."@de ;
                 rdfs:label "befindetSichAuf"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#befindetSichIn
:befindetSichIn rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ,
                            <http://webprotege.stanford.edu/RkOjPOSAupTHuJkOYZlvuK> ;
                rdfs:range <http://webprotege.stanford.edu/R9D3oSTzxCD7g306ncwmKdv> ,
                           <http://webprotege.stanford.edu/RBveoyqPiC9TWJ6DasCpEQt> ;
                rdfs:comment "Ordnet einer Raumstation das Sternsystem zu, in dem sie sich befindet."@de ;
                rdfs:label "befindetSichIn"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#besitzt
:besitzt rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :nutztObjekt ;
         owl:inverseOf :besitztDurch ;
         rdf:type owl:TransitiveProperty ;
         rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
         rdfs:range <http://webprotege.stanford.edu/RkOjPOSAupTHuJkOYZlvuK> ;
         rdfs:comment "Charakter besitzt oder führt ein Objekt."@de ;
         rdfs:label "besitzt"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#besitztDurch
:besitztDurch rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
              rdfs:domain <http://webprotege.stanford.edu/RkOjPOSAupTHuJkOYZlvuK> ;
              rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
              rdfs:comment "Inverse Beziehung zu besitzt."@de ;
              rdfs:label "besitztDurch"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#direktFeindVon
:direktFeindVon rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :stehtInKonfliktMit ;
                rdf:type owl:SymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
                rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
                owl:propertyDisjointWith :verbuendetMit ;
                rdfs:comment "Direkte symmetrische Feindschaft zwischen Charakteren."@de ;
                rdfs:label "direktFeindVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#elternteilVon
:elternteilVon rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :vorfahrVon ;
               owl:inverseOf :kindVon ;
               rdf:type owl:ObjectProperty ;
               rdfs:domain <http://webprotege.stanford.edu/RDS74eivxkEFJ4Y4NKCX3NS> ;
               rdfs:range <http://webprotege.stanford.edu/RDS74eivxkEFJ4Y4NKCX3NS> ;
               rdfs:comment "Ein Charakter ist Elternteil eines anderen Charakters."@de ;
               rdfs:label "elternteilVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#findetStattAuf
:findetStattAuf rdf:type owl:ObjectProperty ;
                owl:inverseOf :istSchauplatzVon ;
                rdf:type owl:FunctionalProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain <http://webprotege.stanford.edu/R0MQXHilk13ixQiCKwFB3v> ;
                rdfs:range <http://webprotege.stanford.edu/R7Tk9abCoMQfGECrnxgjOXl> ;
                rdfs:comment "Ereignis findet auf einem Himmelskörper oder dessen Luftraum statt."@de ;
                rdfs:label "findetStattAuf"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#geborenAuf
:geborenAuf rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain <http://webprotege.stanford.edu/RDS74eivxkEFJ4Y4NKCX3NS> ;
            rdfs:range <http://webprotege.stanford.edu/R7Tk9abCoMQfGECrnxgjOXl> ;
            rdfs:comment "Ordnet ein Lebewesen seinen Geburtsort als Himmelskörper zu."@de ;
            rdfs:label "geborenAuf"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#gehoertZu
:gehoertZu rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain <http://webprotege.stanford.edu/RkOjPOSAupTHuJkOYZlvuK> ;
           rdfs:range <http://webprotege.stanford.edu/R9zzbJR0kGITkMs3EriLmSs> ;
           rdfs:comment "Ordnet ein Objekt einer Organisation zu."@de ;
           rdfs:label "gehörtZu"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#gerettetVon
:gerettetVon rdf:type owl:ObjectProperty ;
             owl:inverseOf :rettet ;
             rdf:type owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
             rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
             rdfs:comment "Inverse Beziehung zu rettet."@de ;
             rdfs:label "gerettetVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#getötetVon
:getötetVon rdf:type owl:ObjectProperty ;
            owl:inverseOf :tötet ;
            rdf:type owl:FunctionalProperty ,
                     owl:AsymmetricProperty ;
            rdfs:domain <http://webprotege.stanford.edu/RDS74eivxkEFJ4Y4NKCX3NS> ;
            rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#hatBewaffnung
:hatBewaffnung rdf:type owl:ObjectProperty ,
                        owl:InverseFunctionalProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain <http://webprotege.stanford.edu/R9D3oSTzxCD7g306ncwmKdv> ,
                           <http://webprotege.stanford.edu/RBveoyqPiC9TWJ6DasCpEQt> ;
               rdfs:range <http://webprotege.stanford.edu/RBi4shWXCnQW3Xf4QcjINvm> ;
               rdfs:comment "Ordnet einem Fahrzeug oder Todesstern eine eingebaute oder zugehörige Waffe zu."@de ;
               rdfs:label "hatBewaffnung"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#hatHeimatwelt
:hatHeimatwelt rdf:type owl:ObjectProperty ;
               owl:inverseOf :heimatweltVon ;
               rdf:type owl:FunctionalProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
               rdfs:range <http://webprotege.stanford.edu/R7Tk9abCoMQfGECrnxgjOXl> ;
               rdfs:comment "Ordnet einem Charakter genau eine hauptsächliche Heimatwelt zu."@de ;
               rdfs:label "hatHeimatwelt"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#hatMachtSeite
:hatMachtSeite rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain <http://webprotege.stanford.edu/R7AUpGFJMAuuejBdLaVxQxC> ;
               rdfs:range <http://webprotege.stanford.edu/RB2uV3yYrOgMfM3WxMJXkiP> ;
               rdfs:comment "Ordnet einem Machtnutzer eine Seite der Macht zu."@de ;
               rdfs:label "hatMachtSeite"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#hatMitglied
:hatMitglied rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty ;
             rdfs:domain <http://webprotege.stanford.edu/R9zzbJR0kGITkMs3EriLmSs> ;
             rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
             rdfs:comment "Inverse Beziehung zu mitgliedVon: Eine Organisation hat einen Charakter als Mitglied."@de ;
             rdfs:label "hatMitglied"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#hatRegierung
:hatRegierung rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain <http://webprotege.stanford.edu/RCELgWPo2fY7U9fSQl9xMDH> ,
                          <http://webprotege.stanford.edu/RCrTdVa8gbToKRrS8ShYiBz> ;
              rdfs:range :Regierung ;
              rdfs:comment "Ordnet einem Planeten oder Mond genau eine Regierung zu."@de ;
              rdfs:label "hatRegierung"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#hatTeilnehmer
:hatTeilnehmer rdf:type owl:ObjectProperty ;
               owl:inverseOf :nimmtTeilAn ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain <http://webprotege.stanford.edu/R0MQXHilk13ixQiCKwFB3v> ;
               rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
               rdfs:comment "Inverse Beziehung zu nimmtTeilAn."@de ;
               rdfs:label "hatTeilnehmer"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#hatZiel
:hatZiel rdf:type owl:ObjectProperty ;
         owl:inverseOf :istZielVon ;
         rdf:type owl:TransitiveProperty ;
         rdfs:domain <http://webprotege.stanford.edu/R0MQXHilk13ixQiCKwFB3v> ;
         rdfs:range owl:Thing ;
         rdfs:comment "Ereignis hat ein strategisches Ziel."@de ;
         rdfs:label "hatZiel"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#heimatweltVon
:heimatweltVon rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain <http://webprotege.stanford.edu/R7Tk9abCoMQfGECrnxgjOXl> ;
               rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
               rdfs:comment "Gibt an, welche Charaktere einem Himmelskörper als Heimatwelt zugeordnet sind."@de ;
               rdfs:label "heimatweltVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#istFeindVonOrganisation
:istFeindVonOrganisation rdf:type owl:ObjectProperty ,
                                  owl:ObjectProperty ;
                         rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
                         rdfs:range <http://webprotege.stanford.edu/R9zzbJR0kGITkMs3EriLmSs> ;
                         owl:propertyChainAxiom ( <http://webprotege.stanford.edu/R8BaQuU8CrsgAlHU7bH0vUd>
                                                  :organisationFeindVon
                                                ) ;
                         rdfs:comment "Leitet ab, dass ein Charakter mit einer Organisation im Konflikt steht, wenn seine eigene Organisation mit dieser Organisation verfeindet ist."@de ;
                         rdfs:label "istFeindVonOrganisation"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#istSchauplatzVon
:istSchauplatzVon rdf:type owl:ObjectProperty ,
                           owl:InverseFunctionalProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain <http://webprotege.stanford.edu/R7Tk9abCoMQfGECrnxgjOXl> ;
                  rdfs:range <http://webprotege.stanford.edu/R0MQXHilk13ixQiCKwFB3v> ;
                  rdfs:comment "Inverse Beziehung zu findetStattAuf."@de ;
                  rdfs:label "istSchauplatzVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#istZielVon
:istZielVon rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain owl:Thing ;
            rdfs:range <http://webprotege.stanford.edu/R0MQXHilk13ixQiCKwFB3v> ;
            rdfs:comment "Inverse Beziehung zu hatZiel."@de ;
            rdfs:label "istZielVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#kindVon
:kindVon rdf:type owl:ObjectProperty ,
                  owl:ObjectProperty ;
         rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
         rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
         rdfs:comment "Inverse Beziehung zu elternteilVon."@de ;
         rdfs:label "kindVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#kommandiert
:kommandiert rdf:type owl:ObjectProperty ;
             owl:inverseOf :wirdKommandiertVon ;
             rdf:type owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
             rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ,
                        <http://webprotege.stanford.edu/RBveoyqPiC9TWJ6DasCpEQt> ;
             rdfs:comment "Charakter kommandiert ein Objekt, eine Organisation oder ein Ereignis."@de ;
             rdfs:label "kommandiert"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#nimmtTeilAn
:nimmtTeilAn rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
             rdfs:range <http://webprotege.stanford.edu/R0MQXHilk13ixQiCKwFB3v> ;
             rdfs:comment "Charakter nimmt an einem Ereignis teil."@de ;
             rdfs:label "nimmtTeilAn"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#nutztObjekt
:nutztObjekt rdf:type owl:ObjectProperty ,
                      owl:ObjectProperty ;
             rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
             rdfs:range <http://webprotege.stanford.edu/RkOjPOSAupTHuJkOYZlvuK> ;
             rdfs:comment "Ein Charakter nutzt ein Objekt, zum Beispiel eine Waffe oder ein Fahrzeug."@de ;
             rdfs:label "nutztObjekt"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#organisationFeindVon
:organisationFeindVon rdf:type owl:ObjectProperty ,
                               owl:SymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain <http://webprotege.stanford.edu/R9zzbJR0kGITkMs3EriLmSs> ;
                      rdfs:range <http://webprotege.stanford.edu/R9zzbJR0kGITkMs3EriLmSs> ;
                      rdfs:comment "Symmetrische Feindschaft zwischen Organisationen."@de ;
                      rdfs:label "organisationFeindVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#pilotiert
:pilotiert rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :nutztObjekt ;
           rdf:type owl:FunctionalProperty ,
                    owl:InverseFunctionalProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
           rdfs:range <http://webprotege.stanford.edu/R9D3oSTzxCD7g306ncwmKdv> ;
           rdfs:comment "Spezielle Form von nutztObjekt: Ein Charakter steuert ein Fahrzeug."@de ;
           rdfs:label "pilotiert"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#rettet
:rettet rdf:type owl:ObjectProperty ,
                 owl:AsymmetricProperty ,
                 owl:IrreflexiveProperty ;
        rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
        rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
        rdfs:comment "Charakter rettet einen anderen Charakter."@de ;
        rdfs:label "rettet"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#stehtInKonfliktMit
:stehtInKonfliktMit rdf:type owl:ObjectProperty ,
                             owl:SymmetricProperty ;
                    rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
                    rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
                    owl:propertyChainAxiom ( <http://webprotege.stanford.edu/R8BaQuU8CrsgAlHU7bH0vUd>
                                             :organisationFeindVon
                                             :hatMitglied
                                           ) ,
                                           ( <http://webprotege.stanford.edu/R8BaQuU8CrsgAlHU7bH0vUd>
                                             :organisationFeindVon
                                             [ owl:inverseOf <http://webprotege.stanford.edu/R8BaQuU8CrsgAlHU7bH0vUd>
                                             ]
                                           ) ;
                    rdfs:comment "Abgeleiteter Konflikt zwischen Charakteren über verfeindete Organisationen."@de ;
                    rdfs:label "stehtInKonfliktMit"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#traegtWaffe
:traegtWaffe rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :nutztObjekt ;
             rdf:type owl:InverseFunctionalProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
             rdfs:range <http://webprotege.stanford.edu/RBi4shWXCnQW3Xf4QcjINvm> ;
             rdfs:comment "Spezielle Form von nutztObjekt: Ein Charakter führt eine Waffe."@de ;
             rdfs:label "traegtWaffe"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#trainiert
:trainiert rdf:type owl:ObjectProperty ;
           owl:inverseOf :trainiertVon ;
           rdf:type owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
           rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
           rdfs:comment "Charakter trainiert einen anderen Charakter."@de ;
           rdfs:label "trainiert"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#trainiertVon
:trainiertVon rdf:type owl:ObjectProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
              rdfs:range <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
              rdfs:comment "Charakter wurde von einem anderen Charakter trainiert."@de ;
              rdfs:label "trainiertVon"@de .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#tötet
:tötet rdf:type owl:ObjectProperty ,
                owl:InverseFunctionalProperty ,
                owl:AsymmetricProperty ;
       rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
       rdfs:range <http://webprotege.stanford.edu/RDS74eivxkEFJ4Y4NKCX3NS> .


###  urn:webprotege:ontology:d3169af1-f7dc-449d-85dc-cf437ed51cbd#verbuendetMit
:verbuendetMit rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ;
               rdfs:domain <http://webprotege.stanford.edu/R9P6raN64M1uNp9ytb7AjlV> ;
